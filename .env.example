# Seyirlik media server.
#
# Seyirlik serves its own API from this process. There is no Jellyfin, no server
# URL for the browser to configure, and no access token in local storage — the
# session is an HttpOnly cookie issued by this server.
#
# First run:
#   docker compose up -d          # PostgreSQL
#   npm run db:migrate
#   npm run admin:provision -- --username you --display-name "You"
#   npm run server

# ---------------------------------------------------------------- process
SEYIRLIK_HOST=127.0.0.1
SEYIRLIK_PORT=43110

# ------------------------------------------------------------------ media
SEYIRLIK_MEDIA_ROOT=/absolute/path/to/media

# Libraries are provisioned from this on every start, idempotently. `roots` are
# relative to SEYIRLIK_MEDIA_ROOT; `kind` is movies, series, books, collections
# or mixed. Folders you do not list are simply never scanned.
SEYIRLIK_LIBRARIES=[{"slug":"movies","name":"Movies","kind":"movies","roots":["Movies"]},{"slug":"series","name":"Series","kind":"series","roots":["Series"]},{"slug":"books","name":"Books","kind":"books","roots":["Books"]}]

# Cached artwork, trickplay sheets and HLS working files. Keep this OUTSIDE
# SEYIRLIK_MEDIA_ROOT: library automation that scans the media root (FileFlows,
# Tdarr and similar) will otherwise delete what Seyirlik generates.
SEYIRLIK_GENERATED_STORAGE=/absolute/path/to/generated

# --------------------------------------------------------------- database
# Required. The catalogue, watch state, sessions and job queue all live here, so
# the server refuses to start without it rather than running half-configured.
DATABASE_URL=postgresql://seyirlik:change-me@127.0.0.1:5432/seyirlik
# Read by docker-compose.yml; must match the password above.
SEYIRLIK_DB_PASSWORD=change-me
SEYIRLIK_DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- secrets
# Two independent values, each at least 32 bytes. One keys the stored session
# token hash, the other signs CSRF tokens; reusing one for both is rejected.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEYIRLIK_SESSION_HASH_SECRET=
SEYIRLIK_CSRF_SECRET=

# Optional. Lets people create their own account with an invite code an
# administrator made on the people page (/dev/users). Signing up also needs a
# Cloudflare Turnstile check, so it stays closed unless both keys are set;
# setting only one stops the server at startup. Create a widget for the hosts
# the site is served from; Cloudflare's test keys (site
# 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA) pass
# every check, for local work only.
# SEYIRLIK_TURNSTILE_SITE_KEY=
# SEYIRLIK_TURNSTILE_SECRET_KEY=

# --------------------------------------------------------------- metadata
# Optional. Without it the catalogue still scans, probes and plays — titles are
# just what the folder names say, with no artwork.
#
# Both TMDB credential formats work: a v3 key (32 hex characters) travels as a
# query parameter, a v4 read access token as a bearer header. Backend only; this
# is never sent to a browser.
SEYIRLIK_TMDB_API_KEY=

# ----------------------------------------------------------------- ffmpeg
# Omit to use whatever is on PATH.
# SEYIRLIK_FFMPEG_PATH=ffmpeg
# SEYIRLIK_FFPROBE_PATH=ffprobe
# `auto`, `hardware`, `software`, or a specific encoder such as h264_qsv.
SEYIRLIK_FFMPEG_VIDEO_ENCODER=auto
SEYIRLIK_MAX_VIDEO_TRANSCODES=1
# Optional explicit override; automatic topology detection is preferred.
# SEYIRLIK_SOFTWARE_TRANSCODE_THREADS=8

# ------------------------------------------------------------------ hosting
# Set only when the app is served from a different host to this API — a static
# host in front, this server behind. Both must share a registrable domain, so
# requests between them stay same-site and the session cookie is still sent.
# Widening the cookie to the parent domain is what lets the app read the CSRF
# token this API issues.
#   SEYIRLIK_COOKIE_DOMAIN=example.org
# and build the frontend with VITE_OWN_API_BASE_URL=https://api.example.org
# SEYIRLIK_COOKIE_DOMAIN=

# Point this at the built frontend (`npm run build` writes ./dist) to serve the
# app and its API from one origin. That is what a public deployment wants: the
# session cookie is same-origin, no CORS exception is needed, and media bytes go
# straight from this process instead of through a proxy that would have to carry
# every stream.
# Leave it unset to serve only the API.
# SEYIRLIK_STATIC_ROOT=/absolute/path/to/dist

# ----------------------------------------------------------------- origins
# Browsers may call the API from these origins. Same-origin needs no entry, and
# production trusts nothing it was not told to trust.
SEYIRLIK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set when TLS terminates at a trusted proxy, to the canonical browser origin.
# Forwarded headers are deliberately not trusted in its place.
# SEYIRLIK_PUBLIC_ORIGIN=https://www.seyirlik.org

# --------------------------------------------------------------- restarting
# The Server Control page (/dev/server-control) can restart this process. How it
# comes back depends on how you started it:
#
#   respawn     the process starts its own replacement before exiting. This is
#               what `npm run server` needs, and the default.
#   supervisor  the process just exits cleanly and something else starts it
#               again. Use this under Docker with a restart policy, pm2, or
#               launchd. systemd is detected automatically via INVOCATION_ID.
#   disabled    the endpoints refuse and the page explains why.
#
# Getting this wrong is not subtle: `supervisor` with no supervisor leaves the
# server stopped, and `respawn` under one starts two servers on one port.
# SEYIRLIK_RESTART_MODE=respawn

# --------------------------------------------------------------- background
# Whether the API process also runs background jobs — scanning, probing,
# artwork and encoding. Default true: one process is the right shape for one
# machine.
#
# Set false and run `npm run worker` alongside it to split the deployment in
# two. The halves meet only in the job queue, so either can be restarted
# without disturbing the other: the site can come back while an encode carries
# on, and a wedged encoder cannot take playback down with it.
# SEYIRLIK_RUN_WORKER=true

# ---------------------------------------------------------------- nfo export
# Kodi/Jellyfin .nfo sidecars generated as the final stage of every library
# scan. Existing non-Seyirlik NFO files are preserved by default.
#
#   disabled   explicit opt-out; nothing is generated
#   preview    XML through the admin API only; no file is ever written
#   generated  files under SEYIRLIK_GENERATED_STORAGE/nfo/, mirroring the
#              media layout, so you can review or rsync them yourself
#   sidecar    files beside the media, which is the only layout Kodi reads
#              (default)
# SEYIRLIK_NFO_EXPORT=sidecar

# `managed-only` replaces only files carrying Seyirlik's generator marker, so a
# legacy Jellyfin, Radarr, Sonarr or hand-written .nfo is reported as a conflict
# and left alone. `force` replaces any .nfo. Nothing is ever deleted.
# SEYIRLIK_NFO_OVERWRITE=managed-only

# Library slugs whose .nfo files a Radarr or Sonarr instance already owns.
# Seyirlik never writes to these, whatever the mode says — two programs
# managing one file is a fight neither of them can detect.
# SEYIRLIK_NFO_ARR_MANAGED_LIBRARIES=movies,shows

# ------------------------------------------------- organising the folders
# Tidying the media folders at the start of every library scan: originals and
# their sidecar subtitles moved into a `src/` bucket, and each episode's .nfo
# filed inside the folder that holds that episode's renditions.
#
#   off    the media volume is never written to by a scan (default)
#   plan   the moves are computed and reported in the scan result; nothing
#          moves. `npm run media:organize:plan` prints the same list.
#   apply  the moves are carried out, then the library is scanned
#
# Nothing is ever overwritten or deleted: a move whose destination is taken is
# reported and skipped. No title changes identity, so packages already built
# keep working and the catalogue keeps its watch history. The pass stands down
# entirely while any processing attempt is queued or running — a running encode
# re-opens its source every few minutes, and a queued one carries the path it
# was queued with.
# SEYIRLIK_MEDIA_ORGANIZE=off

# ------------------------------------------------------ offline renditions
# Fast processing scratch. When set, every job builds and verifies under
# `<root>/jobs/<job-id>` and only a verified package is copied to media storage.
# The exact configured path is required for resume; it never falls back to a
# different disk when unavailable.
# SEYIRLIK_PROCESSING_SCRATCH_ROOT=/Volumes/FastSSD/SeyirlikScratch
#
# Legacy/offline rendition paths. `SEYIRLIK_RENDITION_WORK_ROOT` remains the
# fallback when the processing scratch root above is unset.
# SEYIRLIK_RENDITION_ROOT=/absolute/path/to/renditions
# SEYIRLIK_RENDITION_WORK_ROOT=/absolute/path/to/work
# SEYIRLIK_RENDITION_STATE_ROOT=/absolute/path/to/state
# SEYIRLIK_RENDITION_LOGS_ROOT=/absolute/path/to/logs
# SEYIRLIK_RENDITION_RESERVE_GB=25
# `auto`, `hardware`, `software`, `videotoolbox`, `qsv`, or a specific encoder.
# SEYIRLIK_RENDITION_ENCODER=auto
# SEYIRLIK_RENDITION_HDR=preserve
