{
  "name": "seyirlik-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env --import tsx src/server/mediaServer.ts",
    "worker": "node --env-file=.env --import tsx src/server/mediaWorker.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "bash scripts/test-changed.sh",
    "test:db": "bash scripts/test-db.sh",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "bench:containers": "bash scripts/build-container-benchmark.sh",
    "bench:epochs": "node --import tsx scripts/benchmark-epoch-checkpoints.ts",
    "bench:software-threads": "node --env-file=.env --import tsx scripts/benchmark-software-threads.ts",
    "media:lab:build-matrix": "bash scripts/build-media-test-matrix.sh",
    "media:lab:verify-matrix": "node --env-file=.env --import tsx scripts/verify-media-test-matrix.ts",
    "media:lab:server": "bash scripts/run-media-lab-server.sh",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.{json,js,ts,css,md}\" \"docs/**/*.md\"",
    "db:migrate": "node --env-file=.env --import tsx scripts/run-own-api-migrations.ts",
    "admin:provision": "node --env-file=.env --import tsx scripts/provision-native-admin.ts",
    "media:renditions:analyse": "node --env-file=.env --import tsx scripts/media-renditions.ts analyse",
    "media:renditions:process": "node --env-file=.env --import tsx scripts/media-renditions.ts process",
    "media:renditions:resume": "node --env-file=.env --import tsx scripts/media-renditions.ts resume",
    "media:renditions:status": "node --env-file=.env --import tsx scripts/media-renditions.ts status",
    "media:renditions:validate": "node --env-file=.env --import tsx scripts/media-renditions.ts validate",
    "media:renditions:cleanup": "node --env-file=.env --import tsx scripts/media-renditions.ts cleanup",
    "media:lab:verify-http": "bash scripts/verify-media-lab-http.sh",
    "media:organize:plan": "node --env-file=.env --import tsx scripts/organize-media.ts",
    "media:organize:apply": "node --env-file=.env --import tsx scripts/organize-media.ts --apply",
    "media:artwork:plan": "node --env-file=.env --import tsx scripts/reimport-artwork.ts",
    "media:artwork:reimport": "node --env-file=.env --import tsx scripts/reimport-artwork.ts --apply",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.{json,js,ts,css,md}\"",
    "media:trickplay:migrate:plan": "node --env-file=.env --import tsx scripts/migrate-trickplay-storage.ts --dry-run",
    "media:trickplay:migrate": "node --env-file=.env --import tsx scripts/migrate-trickplay-storage.ts",
    "maintenance:archive-legacy-trickplay": "node --env-file=.env --import tsx scripts/archive-legacy-trickplay.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@material/web": "^2.4.1",
    "animejs": "^4.4.1",
    "argon2": "^0.45.1",
    "embla-carousel-autoplay": "^8.6.0",
    "epubjs": "^0.3.93",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.16",
    "hyphen": "^1.14.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.30.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
