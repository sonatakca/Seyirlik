{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/control",
      "destination": "https://seyirlik-server.tail2f8eaf.ts.net/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()"
        }
      ]
    },
    {
      "source": "/(login|home)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()"
        }
      ]
    },
    {
      "source": "/(app|server|setup|movies|series|series/.*|library|library/.*|season|season/.*|item|item/.*|watch|watch/.*|player|player/.*|dev|dev/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(favicon-16x16.png|favicon-32x32.png|touchicon-seyirlik-v2.png|apple-touch-icon.png|pwa-192x192.png|pwa-512x512.png|maskable-icon-512x512.png|manifest.webmanifest|sw.js|offline-sw.js|alerts-sw.js|registerSW.js|workbox-.*.js|seyirlik-preview.png|robots.txt|sitemap.xml|google8ce07be5ec1e1076.html|version.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|google8ce07be5ec1e1076.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ownAPI/v1/:path*",
      "destination": "/api/own-api-unavailable"
    },
    {
      "source": "/:section(movies|shows|series|season|library|watch|read)/:rest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|SkypeUriPreview|Iframely|redditbot|Pinterestbot|vkShare|Embedly|Mastodon|Viber).*"
        }
      ],
      "destination": "/api/share-preview?route=/:section/:rest*"
    },
    {
      "source": "/((?!assets/|artwork/|favicon-16x16.png|favicon-32x32.png|touchicon-seyirlik-v2.png|apple-touch-icon.png|pwa-192x192.png|pwa-512x512.png|maskable-icon-512x512.png|manifest.webmanifest|sw.js|offline-sw.js|alerts-sw.js|registerSW.js|workbox-.*.js|seyirlik-preview.png|robots.txt|sitemap.xml|google8ce07be5ec1e1076.html|version.json).*)",
      "destination": "/index.html"
    }
  ]
}
